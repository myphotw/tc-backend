# Copy this file to .env and replace placeholders locally. Never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=memory_platform
POSTGRES_USER=tc_backend
POSTGRES_PASSWORD=CHANGE_ME
MASTER_KEY=CHANGE_ME
TC_BACKEND_AUTH_TOKEN=

# Host execution defaults. Relative paths are resolved from the working directory.
PHOTO_PLATFORM_ROOT=./PhotoPlatform
GOOGLE_VISION_CREDENTIAL=./config/secret/google-vision.json

# Docker Compose host-side mounts. Use NAS paths only in the local .env.
PHOTO_PLATFORM_HOST_PATH=./PhotoPlatform
GOOGLE_VISION_CREDENTIAL_HOST=./config/secret/google-vision.json
BACKEND_PORT=8000

# Optional integrations
GOOGLE_API_KEY=
WEATHER_API_KEY=
ASTROMETRY_API_KEY=

# Plate Solve worker timing (seconds)
# Leave PLATE_SOLVE_WORKER_ID empty when scaling; hostname + pid is used.
PLATE_SOLVE_WORKER_ID=
PLATE_SOLVE_POLLING_INTERVAL=5
PLATE_SOLVE_PROVIDER_POLL_INTERVAL=5
PLATE_SOLVE_PROVIDER_TIMEOUT=1800
PLATE_SOLVE_LEASE_SECONDS=300
